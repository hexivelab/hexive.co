---
import { contactUrl } from "../site";
---
<header class="section">
<div class="padding-global">
<div class="container-large">
<div class="padding-section-large">
<div class="max-width-full">
<div class="margin-bottom margin-small">
<h1 class="display-1">We <span class="underline">elevate startups</span> with a bold vision.</h1>
</div>
<p class="text-size-medium mx-ch">We empower startups to craft transformative user experiences, no matter where they are in their journey.</p>
<div class="margin-top margin-medium">
<div class="button-group">
<a class="button is-icon w-inline-block" href={contactUrl}>
<div>Let’s talk</div>
<div class="bt-icon w-embed">
<svg fill="none" height="100%" viewBox="0 0 37 37" width="100%" xmlns="http://www.w3.org/2000/svg">
<path d="M25.1492 8.1585C27.3661 15.5462 34.0138 18.5 34.0138 18.5M34.0138 18.5C34.0138 18.5 27.3646 21.4554 25.1492 28.8415M34.0138 18.5H0.770813" stroke="CurrentColor" stroke-width="2">
</path>
</svg>
</div>
</a>
</div>
</div>
</div>
</div>
</div>
</div>
</header>
